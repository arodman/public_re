def run_sarima(column, time_windows0, df_diff):
    component_name = column
    for (start, end,tw_label) in time_windows0:
        print(component_name)
        time_window = f"{start.strftime('%Y-%m-%d')}_to_{end.strftime('%Y-%m-%d')}"
        tw_label_l=tw_label
        min_rmse = float("inf")
        best_param1 = None
        
        # Filter the data for the specific time window
        filtered_df = df_diff.loc[start:end, column]

        # Check for NaNs in the filtered data
        if filtered_df.isnull().values.any():
            logging.error(f"Component {column} contains NaNs for time window {time_window}. Skipping this time window.")
            continue

        # Split data into training and test sets
        train = filtered_df[:-12]
        test = filtered_df[-12:]
        
        # Hyperparameter tuning using auto_arima
        try:
            model = auto_arima(train, seasonal=True, m=12, trace=True, stepwise=True, error_action='ignore', suppress_warnings=True)
            best_param1 = model.get_params()
            pred = model.predict(n_periods=12)
            rmse = np.sqrt(mean_squared_error(test, pred))
            
            if rmse < min_rmse:
                min_rmse = rmse
                best_param1 = model.get_params()

            sarima_results.loc[f"{component_name}_{tw_label_l}"] = [best_param1, min_rmse]


            complete_data = df_diff.loc[start:end, column]
